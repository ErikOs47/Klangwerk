// Symbol und Versionsangaben für sg-vst3host.exe
#include <winver.h>
1 ICON "icon.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,4,0,0
PRODUCTVERSION 1,4,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040704B0"
    BEGIN
      VALUE "CompanyName", "Sound Groot"
      VALUE "FileDescription", "Sound Groot VST3-Host"
      VALUE "ProductName", "Sound Groot"
      VALUE "FileVersion", "1.4.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x407, 1200
  END
END
