{
  "name": "klangwerk",
  "version": "1.2.0",
  "description": "Sound Groot – eine DAW nach Logic-Vorbild",
  "main": "main.js",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/build.js && electron .",
    "dist:win": "node scripts/build.js && electron-builder --win zip --x64"
  },
  "build": {
    "appId": "de.klangwerk.app",
    "productName": "Sound Groot",
    "files": [
      "main.js",
      "dist/index.html",
      "dist/splash.html",
      "dist/brand/**",
      "dist/vendor/**",
      "dist/samples/**",
      "dist/plugins/**"
    ],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false,
      "icon": "src/brand/icon-256.png"
    },
    "electronLanguages": [
      "de",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "SoundGroot-${version}-win.${ext}"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "author": "Erik"
}
