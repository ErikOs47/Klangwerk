{
  "name": "klangwerk",
  "version": "0.8.5",
  "description": "Klangwerk – eine DAW nach Logic-Vorbild",
  "main": "main.js",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/build.js && electron .",
    "dist:win": "node scripts/build.js && electron-builder --win zip --x64"
  },
  "build": {
    "appId": "de.klangwerk.app",
    "productName": "Klangwerk",
    "files": [
      "main.js",
      "dist/index.html",
      "dist/vendor/**",
      "dist/samples/**"
    ],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false
    },
    "electronLanguages": [
      "de",
      "en-US"
    ],
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "author": "Erik"
}
